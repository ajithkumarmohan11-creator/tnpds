my_app=>
create file
=> forms.py

from django import forms

=> create all required fields here :

class login(forms.Form):
    mobile_number=forms.CharField(
        label='Mobile Number',
        widget=forms.TextInput(
            attrs={
                'placeholder':'Enter Your Mobile Number'
            }
        )
    )

=> my_project=> views.py

create views functions :

def login_views(request):
    if request.method=='POST':          (always POST method)
        form=login(request.POST)
    else:
        form=login()    
    return render(request,'login.html',{'form':form})  


=> my_app => templates =>  login.html

   <form method="post">         (always POST method)
        {% csrf_token %}        ( csrf_token - must for  POST Method )

        {{ form }}              ( include the variable )

        {{ form.as_p }}         ( include the variable as paragraph)

        {{ form.as_ul }}         ( include the variable as ul )



        <div>
            <input type="submit" value="Login">
        </div>

    </form>


=> my_project=> urls.py
=> set path :

    path('',views.login_views,name='login')


=> my_app=>models.py
create models

class table_name(models.Model):
    column_name=models.data_type(attrs)

    class Meta:
    db_table='table_name'

eg=>
class StudentDB(models.Model):
    name = models.CharField(max_length=100)
    email_id=models.EmailField(max_length=100,unique=True)
    password=models.CharField(max_length=100)
    phone=models.CharField(max_length=10,unique=True)

    class Meta:
        db_table='Student_details_DB'


